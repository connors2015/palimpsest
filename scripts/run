#!/usr/bin/env bash
# Run a rig module (or the test suite) with numpy (+pynacl) available, regardless
# of the system python.
# Usage:  scripts/run e2e            # the end-to-end toy chain (transformer)
#         scripts/run node           # multiprocess miners over sockets
#         scripts/run async_node --sim   # async miners with staleness (sim)
#         scripts/run async_node     # async miners over real sockets
#         scripts/run model2         # bigger multi-layer model through the chain
#         scripts/run moe            # sparse MoE + page-attested inference
#         scripts/run moe_transformer   # MoE fused into the deep transformer, on-chain
#         scripts/run run_all        # the falsifier suite -> results/report.md
#         scripts/run redteam_report # the §12.3 stealthy-backdoor red-team
#         scripts/run observe        # instrumented convergence run (live dashboard)
#         scripts/run observe --big  # push model size up (~1M params)
#         scripts/run p2p            # gossip network (in-process sim)
#         scripts/run gossip_net --demo  # async gossip over REAL sockets
#         scripts/run economics      # write-price homeostat + stake/slash
#         scripts/run da             # data-availability: erasure coding + sampling
#         scripts/run dkg            # distributed key generation (no trusted dealer)
#         scripts/run integrated     # beacon + DA + leader election, one live loop
#         scripts/run live           # watch the chain live in a browser (localhost:8737)
#         scripts/run beacon         # threshold-BLS unbiasable randomness beacon
#         scripts/run test           # the pytest suite
# pynacl gives fast Ed25519 (the rig falls back to a slow pure-Python reference
# without it), so it is requested for uv runs; system-python runs use whatever
# crypto backend is importable.
set -euo pipefail
cd "$(dirname "$0")/.."
target="${1:-e2e}"

have() { python3 -c "import $1" 2>/dev/null; }

if [ "$target" = "test" ]; then
  if have numpy && have pytest; then
    exec python3 -m pytest -q
  elif command -v uv >/dev/null 2>&1; then
    exec uv run --with numpy --with pytest --with pynacl --with py_ecc python -m pytest -q
  else
    echo "need numpy+pytest: pip install numpy pytest pynacl   (or install uv)" >&2
    exit 1
  fi
fi

if have numpy; then
  exec python3 -m "rig.${target}" "${@:2}"
elif command -v uv >/dev/null 2>&1; then
  exec uv run --with numpy --with pynacl --with py_ecc python -m "rig.${target}" "${@:2}"
else
  echo "need numpy: pip install numpy pynacl   (or install uv)" >&2
  exit 1
fi
